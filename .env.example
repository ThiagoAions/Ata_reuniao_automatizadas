# ══════════════════════════════════════════════════════════════════
# Ata Facial API — Variáveis de Ambiente
# ══════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env no repositório!
# ══════════════════════════════════════════════════════════════════

# Token de autenticação da API (mínimo 32 caracteres)
# O n8n envia este token no header: Authorization: Bearer <TOKEN>
API_SECRET_TOKEN=TROCAR_ESTE_TOKEN_POR_UM_SEGURO_DE_32_CHARS

# Porta da API (padrão: 7860 para Hugging Face Spaces)
PORT=7860
